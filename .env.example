# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000

# SQLite database file (relative to the project root)
DB_PATH=data/bookstore.db

# Demo administrator created on first start (password lives only in .env)
ADMIN_EMAIL=admin@bookstore.local
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=change-me-123

# Optional demo Customer for manual testing (leave DEMO_CUSTOMER_EMAIL empty to skip)
DEMO_CUSTOMER_EMAIL=reader@bookstore.local
DEMO_CUSTOMER_NAME=Demo Reader
DEMO_CUSTOMER_PASSWORD=change-me-456

# Idle session timeout in minutes (set to 1 when running TC12)
SESSION_TIMEOUT_MINUTES=30

# 1 = seed 30+ demo books when the books table is empty, 0 = keep it empty (TC36)
SEED_BOOKS=1

# 1 = add the Secure flag to cookies (enable when served over HTTPS)
SECURE_COOKIES=0
