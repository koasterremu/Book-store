{
  "name": "team3-bookstore",
  "version": "0.2.0",
  "description": "Book Store website – Sprint 1 & Sprint 2 (Node.js, no external packages)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
